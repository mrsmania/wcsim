{
  // Everything that runs in Node: the Vite config and the scripts (the checks harness, the
  // generators, the pushers). These DO get Node's globals - `process.argv`, `readFileSync`,
  // `__dirname` - which is exactly what `src/` must not have.
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here because the scripts import browser modules for their pure parts - the
    // checks harness reads the storage modules' key constants and their revive functions,
    // and those modules talk to `localStorage`. It type-checks them; it does not run them.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    // Only so a script importing a component does not fail on the syntax. No script does.
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // `src` is here as well as in tsconfig.app.json, and on purpose: the scripts import the
  // domain and state modules (the checks harness exercises them), so a config that checks
  // the scripts has to be able to see them. The guard rail is not exclusivity, it is that
  // the APP project also checks every one of those files WITHOUT Node's globals - so a
  // `process.env` in a component is an error there even though it passes here.
  "include": ["vite.config.ts", "scripts", "src"]
}
