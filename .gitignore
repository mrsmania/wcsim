node_modules
dist
*.local
.DS_Store

# Vite env files. `*.local` above covers .env.local and nothing else, but Vite also reads
# .env and .env.[mode] - and this repo is public. The two variables actually used here are
# designed to ship in the bundle (see .github/workflows/deploy.yml), so this is a guard
# against the next one, not a fix for a leak.
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Playwright verification artifacts
.playwright-mcp

# build-sticker-art's freshness cache: source digests, so replacing a piece of art with an
# older timestamp still re-encodes (H100). Purely local - a fresh clone re-encodes the set
# once and produces byte-identical WebP, so there is nothing to share.
art/stickers-src/.art-digests.json

# Local scratch files
tmp_*

# Self-hosted Supabase stack (local only: holds .env with the DB password, JWT secret,
# service key, SMTP + OAuth credentials). Never commit this - the repo is public.
dkr/
