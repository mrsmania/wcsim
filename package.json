{
  "name": "wcsim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "checks": "esbuild scripts/checks.ts --bundle --format=esm --platform=node | node --input-type=module -",
    "album:fill": "esbuild scripts/album-fill.ts --bundle --format=esm --platform=node | node --input-type=module -",
    "gen:collectibles": "esbuild scripts/gen-collectibles.ts --bundle --format=esm --platform=node | node --input-type=module -",
    "gen:players": "npm run gen:players:game && npm run gen:players:other",
    "gen:players:game": "esbuild scripts/gen-players-page.ts --bundle --format=esm --platform=node | node --input-type=module -",
    "gen:players:other": "esbuild scripts/gen-players-page-other.ts --bundle --format=esm --platform=node | node --input-type=module -",
    "push:collectibles": "node scripts/push-collectibles.mjs",
    "push:sql": "node scripts/push-sql.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "country-flag-icons": "^1.6.19",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  }
}
